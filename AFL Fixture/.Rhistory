install.packages("ggplot2")
library(ggplot2)
df <- data.frame(gender=factor(rep(c("F", "M"), each=200)),
weight=round(c(rnorm(200, mean=65, sd=5))))
library(tidyverse)
df <- as_tibble(df)
#1
p <- ggplot(df, aes(x=weight)) + geom_bar(stat = "count")
df <- data.frame(gender=factor(rep(c("F", "M"), each=200)),
weight=round(c(rnorm(200, mean=65, sd=5))))
library(tidyverse)
df <- as_tibble(df)
#1
p <- ggplot(df, aes(x=weight)) + geom_bar(stat = "count")
#2
pp <- ggplot(df, aes(weight, fill = gender)) +
geom_histogram(stat = "count", position = "dodge")
